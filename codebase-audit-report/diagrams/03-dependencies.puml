  Component(text, "text", "L2", "", $tags="l12")
  Component(vec, "vector", "L2", "", $tags="l12")
  Component(ops, "ops", "L2", "", $tags="l12")
  Component(doc, "doc", "L1", "", $tags="l12")
  Component(fmts, "psd, codecs, heif, raw, affinity", "L0 standalone", "", $tags="l0")
  Component(found, "geom, color, raster, cms", "L0", "", $tags="l0")
  Component(tab, "tablet", "L0", "", $tags="l0")
