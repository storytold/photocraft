AddElementTag("devops", $bgColor="#D5D8DC", $legendText="DevOps/Test")
AddRelTag("skip", $lineColor="#C0392B", $textColor="#C0392B", $legendText="L6 dependency that skips engine (allowed by the layer rule)")
System_Boundary(sys, "SYSTEM - 257,637 LOC") {
  Component(desk, "photocraft", "", "", $tags="l6")
