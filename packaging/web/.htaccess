# Apache (see HOSTING.md). Needs mod_mime; mod_deflate and mod_headers are optional.
AddType application/wasm .wasm
AddType text/javascript .js

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm text/javascript text/html
</IfModule>

<IfModule mod_headers.c>
  # Cross-origin isolation: the page and the script Worker share memory (HOSTING.md › Scripts).
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set Cross-Origin-Embedder-Policy "require-corp"
  <FilesMatch "\.(wasm|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # app/: the app's loader and its list of parts keep their names from release to release; the
  # parts (the app's wasm, gzipped and cut up) carry a content hash. So does the script Worker's
  # loader, beside index.html.
  <FilesMatch "^(photocraft-web\.js|parts\.txt|photocraft-script-worker_loader\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.part-[a-z]+$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
