# Netlify / Cloudflare Pages header rules (see HOSTING.md). Other hosts: set the same headers.
/*
  X-Content-Type-Options: nosniff
  # Cross-origin isolation: the page and the script Worker share memory (HOSTING.md, Scripts).
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache

# app/ holds the app's wasm, gzipped and cut into parts whose names carry a content hash...
/app/*
  Cache-Control: public, max-age=31536000, immutable

# ...and the app's loader and its list of parts, which keep their names from release to release.
/app/photocraft-web.js
  ! Cache-Control
  Cache-Control: no-cache

/app/parts.txt
  ! Cache-Control
  Cache-Control: no-cache

# The script Worker's files keep their names from release to release (Trunk hashes no Worker file).
/photocraft-script-worker*
  ! Cache-Control
  Cache-Control: no-cache
