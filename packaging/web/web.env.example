# Copy to secrets/web.env (chmod 600), then use docker compose --env-file secrets/web.env.
# Login credentials are separate from provider API credentials.
PHOTOCRAFT_WEB_USER=photocraft
PHOTOCRAFT_WEB_PASSWORD=replace-with-a-long-private-password
PHOTOCRAFT_WEB_LANGUAGE=en
PHOTOCRAFT_OPENAI_PROMPT_MODEL=qwen3.6:35b@GPU-HOST
PHOTOCRAFT_COMFYUI_ENDPOINT=http://127.0.0.1:8188
PHOTOCRAFT_OPENAI_PROMPT_ENDPOINT=https://api.openai.com/v1
PHOTOCRAFT_OPENAI_IMAGE_ENDPOINT=https://api.openai.com/v1
# Optional shared key for prompt and image APIs; menu-saved service keys take priority.
OPENAI_API_KEY=
# Optional service-specific environment overrides for the shared key:
PHOTOCRAFT_OPENAI_PROMPT_API_KEY=
PHOTOCRAFT_OPENAI_IMAGE_API_KEY=
