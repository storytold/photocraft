<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tablets only for now. -->
    <supports-screens android:smallScreens="false" android:normalScreens="false"
        android:largeScreens="true" android:xlargeScreens="true" android:requiresSmallestWidthDp="600" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application android:label="PhotoCraft" android:hasCode="true"
        android:extractNativeLibs="true" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity android:name=".PhotoCraftActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|density|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize" android:resizeableActivity="true">
            <meta-data android:name="android.app.lib_name" android:value="photocraft_mobile" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
