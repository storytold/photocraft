<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tablets only for now. -->
    <supports-screens android:smallScreens="false" android:normalScreens="false"
        android:largeScreens="true" android:xlargeScreens="true" android:requiresSmallestWidthDp="600" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application android:label="PhotoCraft" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:theme="@android:style/Theme.Material.NoActionBar"
        android:extractNativeLibs="true" android:enableOnBackInvokedCallback="true">
        <!-- singleTask: "Open with" from another app opens in the running PhotoCraft (onNewIntent). -->
        <activity android:name=".PhotoCraftActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|density|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize" android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open with: the image types PhotoCraft reads. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/tiff" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/bmp" />
                <data android:mimeType="image/x-ms-bmp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
                <data android:mimeType="image/vnd.adobe.photoshop" />
                <data android:mimeType="image/x-photoshop" />
                <data android:mimeType="application/x-photoshop" />
            </intent-filter>
            <!-- Open with, for files whose type the provider doesn't know: by extension. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.psd" />
                <data android:pathPattern=".*\\..*\\.psd" />
                <data android:pathPattern=".*\\.pcraft" />
                <data android:pathPattern=".*\\..*\\.pcraft" />
            </intent-filter>
            <!-- Share to PhotoCraft. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/tiff" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/bmp" />
                <data android:mimeType="image/x-ms-bmp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
                <data android:mimeType="image/vnd.adobe.photoshop" />
            </intent-filter>
        </activity>
    </application>
</manifest>
