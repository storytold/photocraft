{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photocraft.dev/schemas/adapter/v2/wire-response.schema.json",
  "title": "UNREVIEWED DRAFT wire response v2; NOT IMPLEMENTED",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "request_id", "type", "status", "message", "sections"],
  "properties": {
    "protocol": {"const": 2}, "request_id": {"$ref": "common.schema.json#/$defs/token"},
    "type": {"enum": ["hello", "control", "run"]},
    "status": {"enum": ["negotiated", "ok", "ready", "needs_model", "needs_permission", "unavailable", "cancelled", "timeout", "error"]},
    "message": {"type": "string", "minLength": 1, "maxLength": 4096},
    "sections": {"$ref": "common.schema.json#/$defs/sections"},
    "action": {"enum": ["probe", "prepare", "listResources", "evict"]},
    "negotiation": {"type": "object", "additionalProperties": false, "required": ["selected_wire_version", "enabled_features"], "properties": {"selected_wire_version": {"const": 2}, "enabled_features": {"$ref": "common.schema.json#/$defs/features"}}},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "retryable"], "properties": {"code": {"enum": ["unsupported_version", "unsupported_feature", "invalid_request", "unsupported_operation", "unsupported_geometry", "resource_missing", "resource_invalid", "permission_required", "device_unavailable", "policy_violation", "cancelled", "deadline_exceeded", "internal_error"]}, "retryable": {"type": "boolean"}}},
    "readiness": {"enum": ["declared", "files_present", "files_verified", "session_created"]},
    "resources": {"type": "array", "maxItems": 256, "items": {"type": "object", "additionalProperties": false, "required": ["identity", "operation", "operation_version", "readiness"], "properties": {"identity": {"$ref": "common.schema.json#/$defs/resourceIdentity"}, "operation": {"$ref": "common.schema.json#/$defs/token"}, "operation_version": {"$ref": "common.schema.json#/$defs/version"}, "readiness": {"enum": ["missing", "declared", "files_present", "files_verified", "session_created", "invalid"]}}}},
    "outputs": {"$ref": "common.schema.json#/$defs/ports"},
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_policy", "devices", "backend", "runtime_id", "runtime_version", "resource", "configuration_digest", "graph_partitioned", "graph_fallback", "fallback_reason", "evidence", "timing"],
      "properties": {
        "requested_policy": {"$ref": "common.schema.json#/$defs/devicePolicy"},
        "devices": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind"], "properties": {"id": {"$ref": "common.schema.json#/$defs/token"}, "kind": {"enum": ["cpu", "gpu", "npu"]}}}},
        "backend": {"$ref": "common.schema.json#/$defs/token"}, "runtime_id": {"$ref": "common.schema.json#/$defs/token"},
        "runtime_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "resource": {"$ref": "common.schema.json#/$defs/resourceIdentity"}, "configuration_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "graph_partitioned": {"type": "boolean"}, "graph_fallback": {"type": "boolean"},
        "fallback_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}, "evidence": {"enum": ["worker_report", "runtime_profile", "synthetic_fixture"]},
        "timing": {"type": "object", "additionalProperties": false, "required": ["cpu_preprocess_ms", "graph_execution_ms", "cpu_postprocess_ms", "total_ms"], "properties": {"cpu_preprocess_ms": {"type": "number", "minimum": 0, "maximum": 86400000}, "graph_execution_ms": {"type": "number", "minimum": 0, "maximum": 86400000}, "cpu_postprocess_ms": {"type": "number", "minimum": 0, "maximum": 86400000}, "total_ms": {"type": "number", "minimum": 0, "maximum": 86400000}}}
      },
      "allOf": [{"if": {"properties": {"graph_fallback": {"const": true}}}, "then": {"properties": {"fallback_reason": {"type": "string"}, "requested_policy": {"properties": {"allow_graph_fallback": {"const": true}}}}}, "else": {"properties": {"fallback_reason": {"type": "null"}}}}]
    }
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "hello"}}}, "then": {"properties": {"status": {"enum": ["negotiated", "error"]}}, "not": {"required": ["action"]}}, "else": {"not": {"required": ["negotiation"]}}},
    {"if": {"properties": {"type": {"const": "control"}}}, "then": {"required": ["action"], "properties": {"status": {"enum": ["ready", "needs_model", "needs_permission", "unavailable", "cancelled", "timeout", "error"]}}}},
    {"if": {"properties": {"type": {"const": "run"}}}, "then": {"properties": {"status": {"enum": ["ok", "needs_model", "needs_permission", "unavailable", "cancelled", "timeout", "error"]}}, "not": {"required": ["action"]}}},
    {"if": {"properties": {"status": {"const": "negotiated"}}}, "then": {"required": ["negotiation"], "not": {"required": ["error"]}}, "else": {"not": {"required": ["negotiation"]}}},
    {"if": {"properties": {"status": {"const": "ok"}}}, "then": {"required": ["outputs", "execution"], "properties": {"sections": {"minItems": 1}}, "not": {"required": ["error"]}}, "else": {"properties": {"sections": {"maxItems": 0}}, "not": {"anyOf": [{"required": ["outputs"]}, {"required": ["execution"]}]}}},
    {"if": {"properties": {"status": {"const": "ready"}}}, "then": {"not": {"required": ["error"]}, "allOf": [{"if": {"properties": {"action": {"enum": ["probe", "prepare"]}}}, "then": {"required": ["readiness"]}}, {"if": {"properties": {"action": {"const": "listResources"}}}, "then": {"required": ["resources"]}}]}, "else": {"not": {"anyOf": [{"required": ["readiness"]}, {"required": ["resources"]}]}}},
    {"if": {"properties": {"status": {"enum": ["needs_model", "needs_permission", "unavailable", "cancelled", "timeout", "error"]}}}, "then": {"required": ["error"]}},
    {"if": {"required": ["readiness"]}, "then": {"properties": {"action": {"enum": ["probe", "prepare"]}}}},
    {"if": {"required": ["resources"]}, "then": {"properties": {"action": {"const": "listResources"}}}}
  ]
}
