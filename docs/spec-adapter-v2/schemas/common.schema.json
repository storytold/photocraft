{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photocraft.dev/schemas/adapter/v2/common.schema.json",
  "title": "UNREVIEWED DRAFT shared definitions; NOT IMPLEMENTED",
  "$defs": {
    "token": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$(?![\\s\\S])"},
    "resourceId": {"type": "string", "minLength": 3, "maxLength": 260, "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$(?![\\s\\S])"},
    "version": {"type": "string", "minLength": 5, "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$(?![\\s\\S])"},
    "digest": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"},
    "path": {"type": "string", "minLength": 1, "maxLength": 260, "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*(/[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*)*$(?![\\s\\S])"},
    "features": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "versions": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
    "devicePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "allowed_backends", "allow_graph_fallback"],
      "properties": {
        "mode": {"enum": ["auto", "exact", "require_kind"]},
        "target_device": {"$ref": "#/$defs/token"}, "target_kind": {"enum": ["npu", "gpu", "cpu"]},
        "allowed_backends": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
        "allow_graph_fallback": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "auto"}}}, "then": {"not": {"anyOf": [{"required": ["target_device"]}, {"required": ["target_kind"]}]}}},
        {"if": {"properties": {"mode": {"const": "exact"}}}, "then": {"required": ["target_device"], "properties": {"allow_graph_fallback": {"const": false}}, "not": {"required": ["target_kind"]}}},
        {"if": {"properties": {"mode": {"const": "require_kind"}}}, "then": {"required": ["target_kind"], "properties": {"allow_graph_fallback": {"const": false}}, "not": {"required": ["target_device"]}}}
      ]
    },
    "resourceIdentity": {"type": "object", "additionalProperties": false, "required": ["id", "version", "manifest_digest"], "properties": {"id": {"$ref": "#/$defs/resourceId"}, "version": {"$ref": "#/$defs/version"}, "manifest_digest": {"$ref": "#/$defs/digest"}}},
    "sections": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "offset", "length"],
        "properties": {"kind": {"enum": ["icc", "f32"]}, "offset": {"type": "integer", "minimum": 0, "maximum": 268435456}, "length": {"type": "integer", "minimum": 1, "maximum": 268435456}},
        "allOf": [
          {"if": {"properties": {"kind": {"const": "icc"}}}, "then": {"properties": {"length": {"maximum": 4194304}}}},
          {"if": {"properties": {"kind": {"const": "f32"}}}, "then": {"properties": {"length": {"multipleOf": 4}, "offset": {"multipleOf": 4}}}}
        ]
      }
    },
    "port": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "x", "y", "width", "height", "channels", "color_mode", "source_depth", "alpha", "data_section_index"],
      "properties": {
        "kind": {"enum": ["image", "mask"]},
        "x": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}, "y": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
        "width": {"type": "integer", "minimum": 1, "maximum": 16384}, "height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "channels": {"type": "integer", "minimum": 1, "maximum": 5}, "color_mode": {"enum": ["rgb", "gray", "cmyk", "lab"]}, "source_depth": {"enum": [8, 16, 32]},
        "alpha": {"type": "boolean"}, "alpha_type": {"const": "straight"},
        "color_encoding": {"enum": ["icc", "srgb", "linear-srgb", "untagged"]},
        "icc_section_index": {"type": "integer", "minimum": 0, "maximum": 63}, "data_section_index": {"type": "integer", "minimum": 0, "maximum": 63}
      },
      "allOf": [
        {"if": {"properties": {"alpha": {"const": true}}}, "then": {"required": ["alpha_type"]}, "else": {"not": {"required": ["alpha_type"]}}},
        {"if": {"properties": {"kind": {"const": "mask"}}}, "then": {"properties": {"channels": {"const": 1}, "color_mode": {"const": "gray"}, "source_depth": {"const": 32}, "alpha": {"const": false}}, "not": {"anyOf": [{"required": ["color_encoding"]}, {"required": ["icc_section_index"]}]}}, "else": {"required": ["color_encoding"]}},
        {"if": {"required": ["color_encoding"], "properties": {"color_encoding": {"const": "icc"}}}, "then": {"required": ["icc_section_index"]}, "else": {"not": {"required": ["icc_section_index"]}}},
        {"if": {"required": ["color_encoding"], "properties": {"color_encoding": {"enum": ["srgb", "linear-srgb"]}}}, "then": {"properties": {"color_mode": {"const": "rgb"}}}},
        {"if": {"properties": {"color_mode": {"enum": ["rgb", "lab"]}, "alpha": {"const": false}}}, "then": {"properties": {"channels": {"const": 3}}}},
        {"if": {"properties": {"color_mode": {"enum": ["rgb", "lab"]}, "alpha": {"const": true}}}, "then": {"properties": {"channels": {"const": 4}}}},
        {"if": {"properties": {"color_mode": {"const": "gray"}, "alpha": {"const": false}}}, "then": {"properties": {"channels": {"const": 1}}}},
        {"if": {"properties": {"color_mode": {"const": "gray"}, "alpha": {"const": true}}}, "then": {"properties": {"channels": {"const": 2}}}},
        {"if": {"properties": {"color_mode": {"const": "cmyk"}, "alpha": {"const": false}}}, "then": {"properties": {"channels": {"const": 4}}}},
        {"if": {"properties": {"color_mode": {"const": "cmyk"}, "alpha": {"const": true}}}, "then": {"properties": {"channels": {"const": 5}}}}
      ]
    },
    "ports": {"type": "object", "minProperties": 1, "maxProperties": 16, "propertyNames": {"$ref": "#/$defs/token"}, "additionalProperties": {"$ref": "#/$defs/port"}}
  }
}