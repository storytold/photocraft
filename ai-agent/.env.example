# 复制为 .env 后填写；.env 已被 gitignore，不要提交真实 Key。
#
# auto: 有 Key 就用对应厂商；一个 Key 都没有时回退到离线 mock 规划器（仅用于自测）。
# 也可以显式写 deepseek / qwen / openai / mock。
LLM_PROVIDER=auto

# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Qwen / 阿里云百炼 DashScope（OpenAI 兼容模式）
DASHSCOPE_API_KEY=
# QWEN_API_KEY=            # 也可以用这个名字

# OpenAI
OPENAI_API_KEY=

# 可选覆盖（不填用各厂商默认值）
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=             # 一个通用 Key，优先级高于厂商 Key

# PhotoCraft CLI 路径；不填会自动找 ../target/release/photocraft-cli
# PHOTOCRAFT_CLI=../target/release/photocraft-cli

# headless MCP 的读写根目录（默认 ai-agent/workspace）
# PHOTOCRAFT_WORKSPACE=workspace

# 每个 /chat 最多几轮 LLM 决策
MAX_STEPS=16
