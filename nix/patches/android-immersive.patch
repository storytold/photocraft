+    pub fn request_immersive(&self) {
+        let activity = match self.jvm.attach_current_thread(|env| env.new_global_ref(&*self.activity)) {
+            Ok(activity) => activity,
+            Err(error) => {
+                log::warn!(target: "photocraft.immersive", "could not retain the activity: {error}");
+                return;
+            }
+        };
+        let sdk = self.config().sdk_version();
+        self.run_on_java_main_thread(Box::new(move || {
+            if let Err(error) = immersive::apply(activity, sdk) {
+                log::warn!(target: "photocraft.immersive", "could not request immersive bars: {error}");
+            }
+        }));
+    }
+
