      "fixed_environment_command": "$env:PHOTOCRAFT_PROFILE_DEFER_FONTS=$null",
      "launch_command_both_modes": "& '<benchmark-directory>/font-profile.exe' --control <unused-localhost-port> --automation-write-root '<fresh-run-directory>'",
