      },
      "build_commands": [
        "rustup run 1.95.0 cargo clean --offline --release -p egui-wgpu",
        "rustup run 1.95.0 cargo build --release --offline --locked -p photocraft",
        "Copy-Item <workspace>/target/release-build/release/photocraft.exe <benchmark-directory>/font-profile.exe"
      ],
      "build_note": "Offline commands assume the locked dependencies are fetched. Explicit renderer cleaning is required because Cargo otherwise reuses cached immutable git-dependency artifacts.",
      "cleared_environment_before_each_run": [
