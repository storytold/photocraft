      ],
      "recorded_build_environment": {
        "RUSTUP_HOME": "<workspace>/target/rustup-home",
        "CARGO_HOME": "<workspace>/target/cargo-home",
        "CARGO_TARGET_DIR": "<workspace>/target/release-build",
